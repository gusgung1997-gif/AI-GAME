          <div class="flex flex-col items-center text-white text-[10px] cursor-pointer hover:scale-105">
            <div class="w-9 h-9 rounded-lg bg-amber-100 border-2 border-amber-500 flex items-center justify-center text-lg relative">
              🧑<span class="absolute -top-1 -right-1 bg-red-600 text-white text-[9px] px-1 rounded-full">+1</span>
            </div>
            <span>สถานะ</span>
          </div>
