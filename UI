            </div>
          </div>

          <!-- ช่องตัวละครที่ 3 (ว่าง) -->
          <div class="rpg-card p-3 flex flex-col items-center justify-between h-64 opacity-90 hover:opacity-100 cursor-pointer">
            <div class="w-full bg-slate-700 text-gray-200 text-center text-xs py-1 rounded">ช่องว่าง</div>
            <div class="w-20 h-20 rounded-full border-4 border-[#c5a059] bg-[#efe6cf] flex items-center justify-center text-2xl text-amber-800 font-bold shadow-inner">
              +
            </div>
            <div class="text-center space-y-1">
              <div class="rpg-ribbon text-xs">สร้างตัวละคร</div>
              <div class="text-xs text-gray-600">ตัวละครใหม่<br>เริ่มที่ Lv.1</div>
            </div>
          </div>

          <!-- แผงควบคุมด้านขวา -->
          <div class="flex flex-col items-center justify-between h-64 py-1 text-center">
            <div class="space-y-1">
              <div class="text-xs text-gray-600">บัญชี Google:</div>
              <div class="text-xs font-bold text-[#1c315e] break-all">gusgung1997@gmail.com</div>
              <div class="text-xs text-gray-700">ตัวละคร <span class="bg-[#1c315e] text-white px-2 py-0.5 rounded-full text-[11px]">1/3</span></div>
            </div>

            <div class="w-full space-y-2.5">
              <button class="rpg-btn-blue w-full py-3 rounded-full font-bold text-lg">
                ✦ เริ่มเกม ✦
              </button>
              <button class="rpg-btn-cream w-full py-1.5 rounded-lg text-xs font-semibold">
                ลบตัวละคร
              </button>
            </div>

            <div class="w-full pt-2 border-t border-dashed border-amber-700/30 space-y-1.5">
              <div class="text-xs font-semibold text-gray-700">เปลี่ยนบัญชี Google</div>
              <button class="rpg-btn-cream px-4 py-1 rounded text-xs">ออกจากระบบ</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- 3. หน้าจอเล่นเกม HUD (IMG_4863)             -->
    <!-- ========================================== -->
    <section id="screen-hud" class="screen-section hidden w-full max-w-5xl h-[540px] rounded-xl border-2 border-amber-500/50 relative overflow-hidden bg-gradient-to-br from-emerald-900/40 via-stone-800/60 to-slate-900/80 p-3 flex flex-col justify-between">
      
      <!-- แถบบน (ซ้าย: โปรไฟล์ / กลาง: เมนูหลัก / ขวา: มินิแมพ) -->
      <div class="flex justify-between items-start gap-2">
        
        <!-- มุมซ้ายบน: ข้อมูลตัวละคร HP/SP/EXP -->
