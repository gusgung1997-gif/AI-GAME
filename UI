          <div class="bg-[#16294d]/95 border-2 border-[#d4af37] rounded-lg p-2 flex items-center gap-2.5 shadow-lg w-64">
            <div class="relative">
              <div class="w-12 h-12 rounded-lg bg-slate-700 border-2 border-amber-400 flex items-center justify-center text-2xl">🥷</div>
              <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 bg-black/90 text-amber-300 text-[9px] px-1.5 rounded border border-amber-500 whitespace-nowrap">Lv.122</span>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex justify-between items-center text-[11px] text-white font-bold">
                <span>มังกรกินหมี่</span>
                <span class="text-amber-300">🪙 799k</span>
              </div>
              <!-- HP Bar -->
              <div class="w-full h-3 bg-gray-900 rounded-sm border border-gray-600 relative overflow-hidden">
                <div class="bg-gradient-to-r from-red-700 to-red-500 h-full w-full"></div>
                <span class="absolute inset-0 text-[9px] text-white text-center leading-3 font-semibold">4490 / 4490</span>
              </div>
              <!-- SP Bar -->
