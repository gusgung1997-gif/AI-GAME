          </div>
          <div class="flex flex-col items-center text-white text-[10px] cursor-pointer hover:scale-105">
            <div class="w-9 h-9 rounded-lg bg-amber-100 border-2 border-amber-500 flex items-center justify-center text-lg">🎛️</div>
            <span>เพิ่มเติม</span>
          </div>
        </div>

        <!-- มุมขวาบน: Mini-map -->
        <div class="bg-[#16294d]/95 border-2 border-[#d4af37] rounded-lg p-1.5 w-40 shadow-lg text-white">
          <div class="flex justify-between items-center text-[10px] px-1 pb-1">
            <span class="font-bold text-amber-300">CH 12 ▾</span>
            <span>🗺️ ✕</span>
          </div>
          <div class="w-full h-24 bg-stone-300 rounded border border-amber-500/60 flex items-center justify-center text-xs text-stone-700 font-bold">
            [Mini-Map]
          </div>
          <div class="text-center text-[11px] font-bold text-amber-300 mt-1">Aurelia Forum</div>
          <div class="flex justify-around text-[10px] text-gray-200 border-t border-white/10 pt-0.5 mt-0.5">
            <span>👥 19</span>
            <span>⌖ 23,47</span>
          </div>
        </div>
      </div>

      <!-- พื้นที่ตรงกลางฉาก (ตัวละครจำลอง) -->
      <div class="flex flex-col items-center justify-center text-white">
        <div class="text-4xl">🥷</div>
        <div class="bg-black/60 px-2 py-0.5 rounded text-xs font-bold mt-1">มังกรกินหมี่</div>
        <div class="text-[10px] text-amber-300">✦ ผู้บุกเบิก ✦</div>
      </div>

      <!-- แถบล่าง (ซ้าย: Joystick / ขวา: ปุ่มสกิล Action) -->
      <div class="flex justify-between items-end">
        <!-- ซ้ายล่าง: Virtual Joystick & Status -->
