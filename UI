              🥷
            </div>
            <div class="text-center space-y-1">
              <div class="rpg-ribbon font-bold">มังกรกินหมี่</div>
              <div class="font-bold text-sm text-amber-950">Kensei</div>
              <div class="text-[11px] text-gray-500">📍 Aurelia F...</div>
            </div>
          </div>

          <!-- ช่องตัวละครที่ 2 (ว่าง) -->
          <div class="rpg-card p-3 flex flex-col items-center justify-between h-64 opacity-90 hover:opacity-100 cursor-pointer">
            <div class="w-full bg-slate-700 text-gray-200 text-center text-xs py-1 rounded">ช่องว่าง</div>
            <div class="w-20 h-20 rounded-full border-4 border-[#c5a059] bg-[#efe6cf] flex items-center justify-center text-2xl text-amber-800 font-bold shadow-inner">
